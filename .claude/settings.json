{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAllHooks": false,
  "permissions": {
    "deny": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/sdlc.json)",
      "Edit(/.githooks/**)",
      "Edit(/tools/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/agents/**)",
      "Edit(**/.claude/skills/**)",
      "Edit(**/.claude/sdlc.json)",
      "Edit(**/.githooks/**)",
      "Edit(/.slopwatch/**)",
      "Edit(**/.slopwatch/**)",
      "Bash(slopwatch *--update-baseline*)",
      "Bash(dotnet tool run slopwatch *--update-baseline*)",
      "Bash(dotnet slopwatch *--update-baseline*)",
      "Bash(*slopwatch *--create-baseline*)",
      "Bash(slopwatch init*)",
      "Bash(dotnet slopwatch init*)",
      "Bash(dotnet tool run slopwatch init*)",
      "Edit(/.config/dotnet-tools.json)",
      "Edit(**/.config/dotnet-tools.json)",
      "Edit(/dotnet-tools.json)",
      "Bash(dotnet tool install*)",
      "Bash(dotnet tool update*)",
      "Bash(dotnet tool uninstall*)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push *:main*)",
      "Bash(git push *:master*)",
      "Bash(git push --no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git config *core.hooksPath*)",
      "Bash(git config *core.hookspath*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git -c core.hookspath*)"
    ],
    "ask": ["Bash(git push *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-guard.ps1"
            ],
            "onFailure": "block",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-guard.ps1"
            ],
            "onFailure": "block",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-format.ps1"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dotnet-skills@dotnet-skills": true,
    "microsoft-docs@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dotnet-skills": {
      "source": {
        "source": "github",
        "repo": "Aaronontheweb/dotnet-skills"
      }
    }
  }
}

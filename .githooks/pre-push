#!/bin/sh
# Hook git pre-push (aktywny przez: git config core.hooksPath .githooks - ustawia Init-SDLC.ps1).
# Dla każdej wypychanej gałęzi topic/* uruchamia tools/Test-TopicReady.ps1 i blokuje push
# przy NO-GO. Inne gałęzie przepuszcza. Człowiek może świadomie pominąć: git push --no-verify
# (agent AI ma na to zakaz w .claude/settings.json).

root="$(git rev-parse --show-toplevel)" || exit 1
ps=powershell
command -v powershell >/dev/null 2>&1 || ps=pwsh

zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/heads/topic/*)
            [ "$local_sha" = "$zero" ] && continue   # usuwanie gałęzi zdalnej
            branch="${local_ref#refs/heads/}"
            echo "[SDLC] pre-push: sprawdzam bramki dla $branch"
            "$ps" -NoProfile -ExecutionPolicy Bypass -File "$root/tools/Test-TopicReady.ps1" -Branch "$branch" </dev/null || status=1
            ;;
    esac
done

if [ "$status" -ne 0 ]; then
    echo "[SDLC] Push zablokowany (NO-GO). Spełnij warunki powyżej albo świadomie pomiń: git push --no-verify"
fi
exit $status
